{
  "name": "ardy-mini-browser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "copy:ort": "node scripts/copy-ort-assets.mjs",
    "predev": "npm run copy:ort",
    "dev": "vite --host 0.0.0.0",
    "prebuild": "npm run copy:ort",
    "build": "tsc --noEmit && vite build",
    "prepreview": "npm run copy:ort",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@huggingface/tokenizers": "0.1.3",
    "onnxruntime-web": "1.27.0",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@types/three": "0.185.1",
    "jsdom": "29.0.1",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
